AT_API_KEY=
AT_USERNAME=
CF_TURN_API_TOKEN=
CF_TURN_KEY_ID=
CRON_SECRET=
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=false
AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite,openai/gpt-5.6-luna,google/gemini-3.1-flash-lite
AI_PROVIDER_ORDER=gateway,groq,cloudflare,gemini,openai
# Milliseconds before a slow lead provider is raced against the next one (0 disables hedging).
AI_HEDGE_MS=2500
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
INTERNAL_API_SECRET=
INDEXNOW_KEY=
MIN_TXN_KES=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna,gpt-5-mini,gpt-5-nano
OPENAI_REASONING_EFFORT=medium
PART_PAYMENT_TTL_HOURS=
PAYHERO_CALLBACK_TOKEN=
PAYHERO_CHANNEL_ID=
PAYHERO_PASSWORD=
PAYHERO_USERNAME=
PUBLIC_BASE_URL=
PUSH_ADMIN_SECRET=
RESEND_API_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
# Where Cabana 3D Tour requests are emailed (comma-separated, max 5). Defaults to apatmento@gmail.com.
TOUR3D_TEAM_EMAIL=
TURN_CREDENTIAL=
TURN_STATIC_SECRET=
TURN_URLS=
TURN_USERNAME=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
WELCOME_CREDIT_FROM=
WELCOME_CREDIT_POINTS=
# Identity verification (purple tick). API key from the Didit console → your LIVE application → API keys.
DIDIT_API_KEY=
# Optional: defaults to the "Free KYC" workflow (document + liveness + face match).
DIDIT_WORKFLOW_ID=
# Optional but recommended: signing secret of the webhook pointing at https://cabana.africa/api/didit-webhook
DIDIT_WEBHOOK_SECRET=
# Optional: Groq vision models used as the free fallback for profile-photo safety checks.
MODERATION_GROQ_MODELS=qwen/qwen3.8-27b
# Secret for identity fingerprints (keyed hashes that link duplicate / banned accounts). Set once; never change.
IDENTITY_PEPPER=

# Cloudflare Workers AI: second fast lane beside Groq, and APA's neural voice.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional comma list of Workers AI chat models, tried in order.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/openai/gpt-oss-120b,@cf/openai/gpt-oss-20b
# Optional Aura-2 voice for APA (thalia, luna, asteria, athena, orion, apollo ...). Default thalia.
APA_VOICE_SPEAKER=thalia
# Cloudflare R2 bucket for PUBLIC photos only (never ids, selfies, receipts or contracts).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cabana-media
# Public https base of the bucket (custom domain preferred over r2.dev), no trailing slash.
R2_PUBLIC_URL=
