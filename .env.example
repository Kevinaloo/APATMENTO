# Identity verification (purple tick). API key from the Didit console → your LIVE application → API keys.
DIDIT_API_KEY=
# Optional: defaults to the "Free KYC" workflow (document + liveness + face match).
DIDIT_WORKFLOW_ID=
# Optional but recommended: signing secret of the webhook pointing at https://cabana.africa/api/didit-webhook
DIDIT_WEBHOOK_SECRET=
# Optional: Groq vision models used as the free fallback for profile-photo safety checks.
MODERATION_GROQ_MODELS=qwen/qwen3.8-27b
# Secret for identity fingerprints (keyed hashes that link duplicate / banned accounts). Set once; never change.
IDENTITY_PEPPER=
