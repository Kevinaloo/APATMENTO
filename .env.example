# Public Supabase client configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# PayHero / M-Pesa
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=
# Long random value shared by the Vercel callback URL and Supabase Edge Function.
PAYHERO_CALLBACK_TOKEN=

# Server-to-server and scheduled-job authentication
CRON_SECRET=
INTERNAL_API_SECRET=
PUSH_ADMIN_SECRET=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:connect@cabana.africa

# Email and AI
RESEND_API_KEY=
GROQ_API_KEY=

# Africa's Talking
AT_USERNAME=
AT_API_KEY=

# Runtime tuning
PUBLIC_BASE_URL=https://cabana.africa
MIN_TXN_KES=10
PART_PAYMENT_TTL_HOURS=24
WELCOME_CREDIT_FROM=
WELCOME_CREDIT_POINTS=
