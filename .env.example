# Public Supabase client configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# PayHero / M-Pesa
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=
# Long random value shared by the Vercel callback URL and Supabase Edge Function.
PAYHERO_CALLBACK_TOKEN=

# Server-to-server and scheduled-job authentication
CRON_SECRET=
INTERNAL_API_SECRET=
PUSH_ADMIN_SECRET=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:connect@cabana.africa

# Email and AI
RESEND_API_KEY=
GROQ_API_KEY=

# Africa's Talking
AT_USERNAME=
AT_API_KEY=

# Runtime tuning
PUBLIC_BASE_URL=https://cabana.africa
MIN_TXN_KES=10
PART_PAYMENT_TTL_HOURS=24
WELCOME_CREDIT_FROM=
WELCOME_CREDIT_POINTS=

# ── In-app voice calling (WebRTC) ────────────────────────────────────
# STUN alone connects most calls and costs nothing, so all of this is
# optional. TURN is what rescues a call behind a carrier NAT, which in
# East Africa is most mobile traffic rather than an edge case.
#
# Option A — Cloudflare Calls. Credentials are minted per hour, so
# nothing long-lived ever reaches a browser.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
#
# Option B — any TURN server. Comma-separated URLs, e.g.
#   turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
# B1: coturn's REST scheme. Preferred; the client gets a time-limited
#     credential rather than a shared password.
TURN_STATIC_SECRET=
# B2: a fixed username and password, if that is all the provider offers.
TURN_USERNAME=
TURN_CREDENTIAL=
