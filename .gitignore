node_modules/
*.bak

# Local secrets — never commit real credentials.
.env
.env.local
.env.*.local

# Python bytecode from the SEO build. These were tracked and mutate on
# every run, so the CI "verify the build is committed" gate could never
# pass on a clean tree.
__pycache__/
*.py[cod]
artifacts/listing-ui/
artifacts/location-flight/

# Local production-audit evidence (may include schema and account metadata).
artifacts/audit*
.vercel/
supabase/.temp/

# Release QA evidence and private synthetic account configuration.
artifacts/release-health/
qa/*.local.json

# Programme redesign QA evidence (screenshots and reports, regenerated on demand).
artifacts/programme-redesign/
artifacts/programme-shots/
