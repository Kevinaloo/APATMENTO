{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.space"
        }
      ],
      "destination": "https://www.apatmento.space/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.vercel.app"
        }
      ],
      "destination": "https://www.apatmento.space/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scrape-events",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/scrape-tours",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/scrape-food",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/scrape-shopping",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/scrape-events.js": {
      "maxDuration": 60
    },
    "api/scrape-tours.js": {
      "maxDuration": 60
    },
    "api/scrape-food.js": {
      "maxDuration": 45
    },
    "api/scrape-shopping.js": {
      "maxDuration": 60
    }
  },
  "env": {
    "PAYHERO_CHANNEL_ID": "9424"
  }
}