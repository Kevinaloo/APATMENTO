{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.space"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.apatmento.space"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cabana.travel"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.cabana.travel"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.cabana.africa"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.vercel.app"
        }
      ],
      "destination": "https://cabana.africa/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/:path*.(png|jpg|jpeg|webp|avif|gif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*.(woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor-:name*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.(mp4|webm|mov|m4v)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap-:name.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scrape?service=shopping",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/scrape?service=food",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/scrape?service=events",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/scrape?service=tours",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/utilities?action=close-bookings",
      "schedule": "10 21 * * *"
    }
  ],
  "functions": {
    "api/rewards.js": {
      "maxDuration": 30
    },
    "api/import-listing.js": {
      "maxDuration": 45
    },
    "api/enhance-listing.js": {
      "maxDuration": 20
    },
    "api/calendar-sync.js": {
      "maxDuration": 30
    },
    "api/scrape.js": {
      "maxDuration": 60
    },
    "api/utilities.js": {
      "maxDuration": 20
    },
    "api/agents.js": {
      "maxDuration": 30
    },
    "api/trust.js": {
      "maxDuration": 45
    },
    "api/stk-callback.js": {
      "maxDuration": 10
    },
    "api/stk-push.js": {
      "maxDuration": 20
    },
    "api/push-send.js": {
      "maxDuration": 30
    },
    "api/email.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/ambassadors",
      "destination": "/api/rewards?_route=ambassadors"
    },
    {
      "source": "/api/match-guest",
      "destination": "/api/trust?action=match-guest"
    },
    {
      "source": "/api/checkin-issue",
      "destination": "/api/trust?action=checkin-issue"
    },
    {
      "source": "/api/deposit-balance",
      "destination": "/api/trust?action=deposit-balance"
    },
    {
      "source": "/api/verify-checkin",
      "destination": "/api/trust?action=verify-checkin"
    },
    {
      "source": "/api/check-payment-status",
      "destination": "/api/trust?action=check-payment-status"
    },
    {
      "source": "/api/ask-apa",
      "destination": "/api/trust?action=ask-apa"
    },
    {
      "source": "/api/geocode",
      "destination": "/api/utilities?action=geocode"
    },
    {
      "source": "/api/indexnow",
      "destination": "/api/utilities?action=indexnow"
    },
    {
      "source": "/api/push-cron",
      "destination": "/api/push-send?action=cron"
    },
    {
      "source": "/api/send-receipt",
      "destination": "/api/email?action=booking"
    },
    {
      "source": "/api/poll-payment",
      "destination": "/api/stk-push?action=poll"
    }
  ],
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": null,
  "framework": null,
  "build": {
    "env": {
      "ENABLE_ROOT_PATH_BUILD_CACHE": "1"
    }
  }
}