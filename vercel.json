{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.space"
        }
      ],
      "destination": "https://www.apatmento.space/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apatmento.vercel.app"
        }
      ],
      "destination": "https://www.apatmento.space/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scrape?service=shopping",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/scrape?service=food",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/scrape?service=events",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/scrape?service=tours",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/ai-chat.js": {
      "maxDuration": 30
    },
    "api/send-receipt.js": {
      "maxDuration": 15
    },
    "api/import-listing.js": {
      "maxDuration": 45
    },
    "api/enhance-listing.js": {
      "maxDuration": 20
    },
    "api/calendar-sync.js": {
      "maxDuration": 30
    },
    "api/scrape.js": {
      "maxDuration": 60
    },
    "api/utilities.js": {
      "maxDuration": 15
    },
    "api/agents.js": {
      "maxDuration": 30
    },
    "api/trust.js": {
      "maxDuration": 30
    },
    "api/stk-callback.js": {
      "maxDuration": 10
    },
    "api/stk-push.js": {
      "maxDuration": 15
    },
    "api/push-send.js": {
      "maxDuration": 10
    }
  },
  "env": {
    "PAYHERO_CHANNEL_ID": "9424"
  },
  "rewrites": [
    {
      "source": "/api/match-guest",
      "destination": "/api/trust?action=match-guest"
    },
    {
      "source": "/api/checkin-issue",
      "destination": "/api/trust?action=checkin-issue"
    },
    {
      "source": "/api/deposit-balance",
      "destination": "/api/trust?action=deposit-balance"
    },
    {
      "source": "/api/verify-checkin",
      "destination": "/api/trust?action=verify-checkin"
    },
    {
      "source": "/api/check-payment-status",
      "destination": "/api/trust?action=check-payment-status"
    },
    {
      "source": "/api/ask-apa",
      "destination": "/api/trust?action=ask-apa"
    }
  ]
}